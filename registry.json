{
  "version": "0.1.0",
  "tokens": "src/tokens/tokens.json",
  "css": ["src/core/fonts.css", "src/tokens/tokens.css", "src/core/core.css"],
  "rules": [
    "Components only reference --nil-* semantic tokens",
    "Never use --nil-primitive-* in components",
    "App-specific colours live in consumer @theme, not NIL primitives",
    "4px default radius (--nil-radius-default) and 2px borders; Toggle uses --nil-radius-full"
  ],
  "components": [
    {
      "name": "Button",
      "tokens": ["--nil-color-accent", "--nil-color-accent-contrast", "--nil-color-text", "--nil-color-border", "--nil-color-surface", "--nil-border-width"],
      "props": { "variant": "primary|secondary|ghost", "size": "sm|md", "disabled": "boolean" }
    },
    {
      "name": "Panel",
      "tokens": ["--nil-color-surface", "--nil-color-text", "--nil-color-border", "--nil-color-bg"],
      "props": { "title": "string?", "variant": "default|inverse" }
    },
    {
      "name": "Stack",
      "tokens": ["--nil-color-border", "--nil-color-surface", "--nil-color-bg", "--nil-color-shadow-stack"],
      "props": { "depth": "1-3" }
    },
    {
      "name": "Dial",
      "tokens": ["--nil-color-accent", "--nil-color-border", "--nil-size-dial-sm|md|lg"],
      "props": { "value": "string|number", "unit": "string?", "progress": "0-100", "size": "sm|md|lg" }
    },
    {
      "name": "Ring",
      "tokens": ["--nil-color-accent", "--nil-color-border", "--nil-size-ring-sm|md"],
      "props": { "value": "0-100", "label": "string?" }
    },
    {
      "name": "Toggle",
      "tokens": ["--nil-color-text", "--nil-color-bg", "--nil-color-border"],
      "props": { "checked": "boolean", "onCheckedChange": "function" }
    },
    {
      "name": "DataRow",
      "tokens": ["--nil-color-text", "--nil-color-text-muted", "--nil-color-surface", "--nil-color-border"],
      "props": { "label": "string", "value": "ReactNode?", "detail": "ReactNode?", "active": "boolean" }
    },
    {
      "name": "TabStrip",
      "tokens": ["--nil-color-text", "--nil-color-text-muted", "--nil-color-border"],
      "props": { "tabs": "string[]", "activeIndex": "number", "onTabChange": "function" }
    },
    {
      "name": "Meta",
      "tokens": ["--nil-color-text", "--nil-color-text-muted", "--nil-color-text-accent", "--nil-color-text-danger", "--nil-color-success", "--nil-color-border", "--nil-font-mono", "--nil-type-scale-xs", "--nil-type-weight-mono", "--nil-type-weight-mono-emphasis", "--nil-radius-default"],
      "props": { "label": "string", "tone": "neutral|accent|danger|success" }
    },
    {
      "name": "Readout",
      "tokens": ["--nil-font-display", "--nil-type-scale-3xl", "--nil-type-scale-2xl", "--nil-color-text-muted"],
      "props": { "value": "string|number", "unit": "string?", "size": "md|lg" }
    },
    {
      "name": "Prompt",
      "tokens": ["--nil-color-text", "--nil-color-text-muted", "--nil-color-text-accent", "--nil-font-mono", "--nil-type-scale-base", "--nil-motion-duration-blink", "--nil-motion-easing-step"],
      "props": { "prefix": "string?", "showCursor": "boolean" }
    },
    {
      "name": "Composer",
      "tokens": ["--nil-color-surface", "--nil-color-text", "--nil-color-text-muted", "--nil-color-border", "--nil-color-accent", "--nil-color-text-accent", "--nil-border-width", "--nil-border-width-thick", "--nil-radius-default", "--nil-font-mono", "--nil-type-scale-base", "--nil-type-scale-xs", "--nil-type-weight-mono", "--nil-spacing-xs", "--nil-spacing-sm", "--nil-spacing-md", "--nil-motion-duration-fast", "--nil-motion-easing-standard"],
      "props": { "label": "string", "showLabel": "boolean", "onSend": "function", "value": "string?", "defaultValue": "string?", "onValueChange": "function?", "status": "idle|sending|streaming", "onStop": "function?", "maxRows": "number", "prefix": "string?", "hint": "string|false", "disabled": "boolean", "ref": "forwarded to the textarea" }
    },
    {
      "name": "Badge",
      "tokens": ["--nil-color-text-muted", "--nil-color-text-accent", "--nil-color-text-danger", "--nil-color-success", "--nil-border-width", "--nil-radius-default", "--nil-font-mono", "--nil-type-scale-xs", "--nil-spacing-xs", "--nil-spacing-sm"],
      "props": { "tone": "neutral|accent|danger|success" }
    },
    {
      "name": "Input",
      "tokens": ["--nil-color-text", "--nil-color-text-muted", "--nil-color-text-danger", "--nil-color-danger", "--nil-color-surface", "--nil-color-border", "--nil-color-accent", "--nil-border-width", "--nil-radius-default", "--nil-font-body", "--nil-type-scale-xs", "--nil-type-scale-sm", "--nil-type-scale-base", "--nil-spacing-xs", "--nil-spacing-sm"],
      "props": { "label": "string", "error": "string?" }
    },
    {
      "name": "ThemeToggle",
      "tokens": ["--nil-color-text", "--nil-color-border", "--nil-color-accent", "--nil-color-accent-contrast", "--nil-border-width", "--nil-radius-default", "--nil-type-scale-xs", "--nil-motion-duration-base", "--nil-motion-easing-standard"],
      "props": { "theme": "light|dark", "onThemeChange": "function", "disabled": "boolean" }
    },
    {
      "name": "Lightbox",
      "tokens": ["--nil-color-overlay", "--nil-color-overlay-fg", "--nil-color-overlay-border", "--nil-color-accent", "--nil-border-width-thick", "--nil-radius-default", "--nil-font-mono", "--nil-type-scale-sm", "--nil-spacing-xs", "--nil-spacing-md", "--nil-spacing-lg", "--nil-spacing-xl", "--nil-spacing-2xl", "--nil-motion-duration-base", "--nil-motion-easing-out-expo"],
      "props": { "image": "{ src, alt }|null", "onClose": "function" }
    }
  ]
}
