{
  "_readme": "Two-layer token architecture. Layer 1 (primitive) is raw values. Layer 2 (semantic) maps roles onto primitives. CSS: --nil-primitive-* raw, --nil-* consumer. Components only reference --nil-*. Light canvas #F3F2EE (lighter than Mothership #EDECE8). Accent #1752eb. Brutalist: 4px default radius (soft brutalist), 2px borders. Generated CSS: npm run tokens:build",

  "primitive": {
    "color": {
      "neutral-0": { "value": "#0a0a0a", "note": "Near-black, ink" },
      "neutral-100": { "value": "#1c1c1c" },
      "neutral-300": { "value": "#4a4a4a" },
      "neutral-500": { "value": "#8a8a8a" },
      "neutral-700": { "value": "#eae9e5", "note": "Light muted surface — stepped off bg" },
      "neutral-900": { "value": "#f3f2ee", "note": "Light canvas — warm off-white" },
      "accent": { "value": "#1752eb", "note": "Locked brand accent" },
      "accent-contrast": { "value": "#ffffff" },
      "danger": { "value": "#c0392b" },
      "success": { "value": "#2e7d4f" },
      "overlay": { "value": "rgba(10, 10, 10, 0.92)", "note": "Lightbox scrim" },
      "overlay-fg": { "value": "#f5f5f4" },
      "overlay-border": { "value": "rgba(245, 245, 244, 0.4)" },
      "grid-line": { "value": "rgba(128, 128, 128, 0.12)" },
      "shadow-stack": { "value": "#0a0a0a", "note": "Stack offset shadow colour" }
    },
    "spacing": {
      "xs": { "value": "4px" },
      "sm": { "value": "8px" },
      "md": { "value": "16px" },
      "lg": { "value": "24px" },
      "xl": { "value": "32px" },
      "2xl": { "value": "64px" }
    },
    "radius": {
      "none": { "value": "0px" },
      "sm": { "value": "4px" },
      "md": { "value": "8px" },
      "lg": { "value": "16px" },
      "xl": { "value": "32px" },
      "full": { "value": "999px" }
    },
    "border": {
      "width": { "value": "1.5px" },
      "width-thick": { "value": "2px" }
    },
    "motion": {
      "duration-fast": { "value": "120ms" },
      "duration-base": { "value": "200ms" },
      "duration-slow": { "value": "360ms" },
      "duration-enter": { "value": "650ms" },
      "duration-blink": { "value": "1100ms" },
      "easing-standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)" },
