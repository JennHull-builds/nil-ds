{
  "_readme": "Two-layer token architecture, extracted from mothership-stable/foundations/tokens.json and generalised. Layer 1 (primitive) is raw values. Layer 2 (semantic) maps roles — background, text, accent — onto primitives per theme. Components should only ever reference semantic tokens, never primitives directly. Palette here is intentionally neutral, not Mothership's lime/mint/pork — swap `primitive.color.accent` for a real brand and every semantic token updates with it.",

  "primitive": {
    "color": {
      "neutral-0": { "value": "#0a0a0a", "note": "Near-black, ink" },
      "neutral-100": { "value": "#1c1c1c" },
      "neutral-300": { "value": "#4a4a4a" },
      "neutral-500": { "value": "#8a8a8a" },
      "neutral-700": { "value": "#d4d4d4" },
      "neutral-900": { "value": "#f5f5f4", "note": "Warm off-white, not pure white" },
      "accent": { "value": "#3b6ef5", "note": "Placeholder brand accent — swap per project" },
      "accent-contrast": { "value": "#ffffff" },
      "danger": { "value": "#c0392b" },
      "success": { "value": "#2e7d4f" }
    },
    "spacing": {
      "xs": { "value": "4px" },
      "sm": { "value": "8px" },
      "md": { "value": "16px" },
      "lg": { "value": "24px" },
      "xl": { "value": "32px" },
      "2xl": { "value": "64px" }
    },
    "radius": {
      "none": { "value": "0px" },
      "sm": { "value": "4px" },
      "md": { "value": "8px" },
      "full": { "value": "999px" }
    },
    "border": {
      "width": { "value": "1px" },
      "width-thick": { "value": "2px" }
    },
    "motion": {
      "duration-fast": { "value": "120ms" },
      "duration-base": { "value": "200ms" },
      "duration-slow": { "value": "360ms" },
      "easing-standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)" }
    },
    "type": {
      "font-body": { "value": "system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "font-mono": { "value": "'JetBrains Mono', ui-monospace, monospace" },
      "scale-xs": { "value": "0.75rem" },
      "scale-sm": { "value": "0.875rem" },
      "scale-base": { "value": "1rem" },
      "scale-lg": { "value": "1.25rem" },
      "scale-xl": { "value": "1.75rem" },
      "scale-2xl": { "value": "2.5rem" }
    }
  },

  "semantic": {
    "light": {
      "color-bg": { "ref": "primitive.color.neutral-900" },
      "color-surface": { "ref": "primitive.color.neutral-700", "note": "Card/input fill, slightly stepped off bg" },
      "color-text": { "ref": "primitive.color.neutral-0" },
      "color-text-muted": { "ref": "primitive.color.neutral-300" },
      "color-border": { "ref": "primitive.color.neutral-0" },
      "color-accent": { "ref": "primitive.color.accent" },
      "color-accent-contrast": { "ref": "primitive.color.accent-contrast" },
      "color-danger": { "ref": "primitive.color.danger" },
      "color-success": { "ref": "primitive.color.success" }
    },
    "dark": {
      "color-bg": { "ref": "primitive.color.neutral-0" },
      "color-surface": { "ref": "primitive.color.neutral-100" },
      "color-text": { "ref": "primitive.color.neutral-900" },
      "color-text-muted": { "ref": "primitive.color.neutral-500" },
      "color-border": { "ref": "primitive.color.neutral-700" },
      "color-accent": { "ref": "primitive.color.accent" },
      "color-accent-contrast": { "ref": "primitive.color.accent-contrast" },
      "color-danger": { "ref": "primitive.color.danger" },
      "color-success": { "ref": "primitive.color.success" }
    }
  }
}
