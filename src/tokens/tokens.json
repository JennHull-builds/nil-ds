      "easing-step": { "value": "step-end" }
    },
    "type": {
      "font-body": { "value": "'IBM Plex Sans', system-ui, sans-serif", "note": "IBM Plex family — load via fonts.css" },
      "font-mono": { "value": "'IBM Plex Mono', ui-monospace, monospace", "note": "CLI labels, meta, nav" },
      "font-display": { "value": "'IBM Plex Mono', ui-monospace, monospace", "note": "Large numeric readouts" },
      "scale-xs": { "value": "0.75rem" },
      "scale-sm": { "value": "0.875rem" },
      "scale-base": { "value": "1rem" },
      "scale-lg": { "value": "1.25rem" },
      "scale-xl": { "value": "1.75rem" },
      "scale-2xl": { "value": "2.5rem" },
      "scale-3xl": { "value": "3.5rem" }
    },
    "size": {
      "dial-sm": { "value": "64px" },
      "dial-md": { "value": "120px" },
      "dial-lg": { "value": "180px" },
      "dial-xl": { "value": "240px" },
      "ring-sm": { "value": "48px" },
      "ring-md": { "value": "72px" }
    },
    "layout": {
      "page-x": { "value": "80px" },
      "section-y": { "value": "120px" },
      "max-width": { "value": "1440px" },
      "columns": { "value": "12" },
      "gutter": { "value": "24px" }
    },
    "breakpoint": {
      "md": { "value": "768px" },
      "lg": { "value": "1024px" }
    }
  },

