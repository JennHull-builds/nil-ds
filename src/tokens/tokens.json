{
  "_readme": "Two-layer token architecture, extracted from mothership-stable/foundations/tokens.json and generalised. Layer 1 (primitive) is raw values. Layer 2 (semantic) maps roles onto primitives — colour per theme, plus spacing/type/radius/border/motion aliases. CSS custom properties: --nil-primitive-* for raw, --nil-* for consumer/semantic. Components should only ever reference --nil-* tokens, never --nil-primitive-* directly. Surfaces are neutral; accent is intentional for v0.1 (not a grey-only slice) — swap `primitive.color.accent` for a real brand. Not Mothership's lime/mint/pork.",

  "primitive": {
    "color": {
      "neutral-0": { "value": "#0a0a0a", "note": "Near-black, ink" },
      "neutral-100": { "value": "#1c1c1c" },
      "neutral-300": { "value": "#4a4a4a" },
      "neutral-500": { "value": "#8a8a8a" },
      "neutral-700": { "value": "#d4d4d4" },
      "neutral-900": { "value": "#f5f5f4", "note": "Warm off-white, not pure white" },
      "accent": { "value": "#3b6ef5", "note": "Placeholder brand accent — swap per project" },
      "accent-contrast": { "value": "#ffffff" },
      "danger": { "value": "#c0392b" },
      "success": { "value": "#2e7d4f" },
      "overlay": { "value": "rgba(10, 10, 10, 0.92)", "note": "Lightbox / modal scrim — theme-stable" },
      "overlay-fg": { "value": "#f5f5f4", "note": "Foreground on overlay" },
      "overlay-border": { "value": "rgba(245, 245, 244, 0.4)" },
      "grid-line": { "value": "rgba(128, 128, 128, 0.12)", "note": "Structural .nil-grid-bg hatch" }
    },
    "spacing": {
      "xs": { "value": "4px" },
      "sm": { "value": "8px" },
      "md": { "value": "16px" },
      "lg": { "value": "24px" },
      "xl": { "value": "32px" },
      "2xl": { "value": "64px" }
    },
    "radius": {
      "none": { "value": "0px" },
      "sm": { "value": "4px" },
      "md": { "value": "8px" },
      "full": { "value": "999px" }
    },
    "border": {
      "width": { "value": "1px" },
      "width-thick": { "value": "2px" }
    },
    "motion": {
      "duration-fast": { "value": "120ms" },
      "duration-base": { "value": "200ms" },
      "duration-slow": { "value": "360ms" },
      "duration-enter": { "value": "650ms", "note": "Scroll / entrance" },
      "duration-blink": { "value": "1100ms", "note": "Terminal cursor step blink" },
      "easing-standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "easing-out-expo": { "value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "easing-step": { "value": "step-end", "note": "Hard on/off — terminal vibe" }
    },
    "type": {
      "font-body": { "value": "system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "font-mono": { "value": "'JetBrains Mono', ui-monospace, monospace" },
      "scale-xs": { "value": "0.75rem" },
      "scale-sm": { "value": "0.875rem" },
      "scale-base": { "value": "1rem" },
      "scale-lg": { "value": "1.25rem" },
      "scale-xl": { "value": "1.75rem" },
      "scale-2xl": { "value": "2.5rem" }
    },
    "layout": {
      "page-x": { "value": "80px", "note": "Horizontal page inset via .nil-container" },
      "section-y": { "value": "120px", "note": "Vertical section rhythm" },
      "max-width": { "value": "1440px" },
      "columns": { "value": "12", "note": "Desktop column count for .nil-grid" },
      "gutter": { "value": "24px", "note": "Same value as spacing.lg" }
    },
    "breakpoint": {
      "md": { "value": "768px", "note": "Documented for parity; media queries use matching literals" },
      "lg": { "value": "1024px" }
    }
  },

  "semantic": {
    "spacing-xs": { "ref": "primitive.spacing.xs" },
    "spacing-sm": { "ref": "primitive.spacing.sm" },
    "spacing-md": { "ref": "primitive.spacing.md" },
    "spacing-lg": { "ref": "primitive.spacing.lg" },
    "spacing-xl": { "ref": "primitive.spacing.xl" },
    "spacing-2xl": { "ref": "primitive.spacing.2xl" },

    "radius-none": { "ref": "primitive.radius.none" },
    "radius-sm": { "ref": "primitive.radius.sm" },
    "radius-md": { "ref": "primitive.radius.md" },
    "radius-full": { "ref": "primitive.radius.full" },

    "border-width": { "ref": "primitive.border.width" },
    "border-width-thick": { "ref": "primitive.border.width-thick" },

    "motion-duration-fast": { "ref": "primitive.motion.duration-fast" },
    "motion-duration-base": { "ref": "primitive.motion.duration-base" },
    "motion-duration-slow": { "ref": "primitive.motion.duration-slow" },
    "motion-duration-enter": { "ref": "primitive.motion.duration-enter" },
    "motion-duration-blink": { "ref": "primitive.motion.duration-blink" },
    "motion-easing-standard": { "ref": "primitive.motion.easing-standard" },
    "motion-easing-out-expo": { "ref": "primitive.motion.easing-out-expo" },
    "motion-easing-step": { "ref": "primitive.motion.easing-step" },

    "color-overlay": { "ref": "primitive.color.overlay", "note": "Theme-stable lightbox scrim" },
    "color-overlay-fg": { "ref": "primitive.color.overlay-fg" },
    "color-overlay-border": { "ref": "primitive.color.overlay-border" },
    "color-grid-line": { "ref": "primitive.color.grid-line" },

    "font-body": { "ref": "primitive.type.font-body" },
    "font-mono": { "ref": "primitive.type.font-mono" },
    "type-scale-xs": { "ref": "primitive.type.scale-xs" },
    "type-scale-sm": { "ref": "primitive.type.scale-sm" },
    "type-scale-base": { "ref": "primitive.type.scale-base" },
    "type-scale-lg": { "ref": "primitive.type.scale-lg" },
    "type-scale-xl": { "ref": "primitive.type.scale-xl" },
    "type-scale-2xl": { "ref": "primitive.type.scale-2xl" },

    "layout-page-x": { "ref": "primitive.layout.page-x" },
    "layout-section-y": { "ref": "primitive.layout.section-y" },
    "layout-max-width": { "ref": "primitive.layout.max-width" },
    "layout-columns": { "ref": "primitive.layout.columns" },
    "layout-gutter": { "ref": "primitive.layout.gutter" },
    "breakpoint-md": { "ref": "primitive.breakpoint.md" },
    "breakpoint-lg": { "ref": "primitive.breakpoint.lg" },

    "light": {
      "color-bg": { "ref": "primitive.color.neutral-900" },
      "color-surface": { "ref": "primitive.color.neutral-700", "note": "Card/input fill, slightly stepped off bg" },
      "color-text": { "ref": "primitive.color.neutral-0" },
      "color-text-muted": { "ref": "primitive.color.neutral-300" },
      "color-border": { "ref": "primitive.color.neutral-0" },
      "color-accent": { "ref": "primitive.color.accent" },
      "color-accent-contrast": { "ref": "primitive.color.accent-contrast" },
      "color-danger": { "ref": "primitive.color.danger" },
      "color-success": { "ref": "primitive.color.success" }
    },
    "dark": {
      "color-bg": { "ref": "primitive.color.neutral-0" },
      "color-surface": { "ref": "primitive.color.neutral-100" },
      "color-text": { "ref": "primitive.color.neutral-900" },
      "color-text-muted": { "ref": "primitive.color.neutral-500" },
      "color-border": { "ref": "primitive.color.neutral-700" },
      "color-accent": { "ref": "primitive.color.accent" },
      "color-accent-contrast": { "ref": "primitive.color.accent-contrast" },
      "color-danger": { "ref": "primitive.color.danger" },
      "color-success": { "ref": "primitive.color.success" }
    }
  }
}
