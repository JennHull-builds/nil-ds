{
  "name": "nil-ds",
  "version": "0.1.0",
  "private": true,
  "description": "NIL DS — token + primitive kit (brutalist CLI lineage). Private until public flip. See PLAN.md.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build:demo": "npm run tokens:build && vite build",
    "preview": "vite preview",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:validate": "node scripts/validate-tokens.mjs",
    "typecheck": "npm run tokens:validate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^29.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vercel": "^59.10.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
